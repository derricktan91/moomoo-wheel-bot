<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0"><dict>
  <key>Label</key><string>com.example.spx-monday-signal</string>
  <!-- Every Monday 20:45 SGT = 45 min before the US open (08:45 ET in EDT).
       The script itself decides whether it is an ideal week; this just
       guarantees one scored prompt per Monday, before you can act on it. -->
  <key>ProgramArguments</key><array>
    <string>__PYTHON__</string>
    <string>__REPO_PATH__/spx_signal.py</string>
    <string>--send</string>
  </array>
  <key>StandardOutPath</key><string>__HOME__/.moomoo_spx_signal.out</string>
  <key>StandardErrorPath</key><string>__HOME__/.moomoo_spx_signal.err</string>
  <key>StartCalendarInterval</key><dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>20</integer>
    <key>Minute</key><integer>45</integer>
  </dict>
</dict></plist>
