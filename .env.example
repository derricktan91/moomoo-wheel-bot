# Copy to ~/.moomoo_alerts.env and fill in. Never commit the real file.

# Telegram bot token from @BotFather
TELEGRAM_BOT_TOKEN=

# Your own Telegram chat id — the only chat served account data
TELEGRAM_CHAT_ID=

# Optional: comma-separated guest chat ids (market-data commands only)
TELEGRAM_GUEST_CHAT_IDS=

# moomoo account id, from the OpenD trade context
MOOMOO_ACC_ID=

# Optional: long-lived token from `claude setup-token`, for the /ask path
CLAUDE_CODE_OAUTH_TOKEN=
