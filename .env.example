# Copy to ~/.moomoo_alerts.env and fill in. Never commit the real file.

# --- Telegram -------------------------------------------------------------
# Token from @BotFather (/newbot)
TELEGRAM_BOT_TOKEN=

# Your own chat id — the only chat ever served account data.
# To find it: start the bot, message it, then read the log line
#   "DENIED chat <id>: '/start'"   — that number is you.
TELEGRAM_CHAT_ID=

# Optional, comma-separated. Guests get market-data commands only.
TELEGRAM_GUEST_CHAT_IDS=

# --- moomoo OpenD ---------------------------------------------------------
# Which moomoo entity holds your account:
#   FUTUSG=Singapore  FUTUINC=US  FUTUSECURITIES=Hong Kong
#   FUTUAU=Australia  FUTUJP=Japan  FUTUMY=Malaysia  FUTUCA=Canada
MOOMOO_SECURITY_FIRM=FUTUSG

# Numeric account id — see SETUP.md for the one-liner that prints it
MOOMOO_ACC_ID=

# Defaults suit a local OpenD; change only if it runs elsewhere
OPEND_HOST=127.0.0.1
OPEND_PORT=11111

# --- Optional -------------------------------------------------------------
# Only needed for /analyse, /news and free-text chat, which shell out to the
# Claude CLI. Generate with: claude setup-token
CLAUDE_CODE_OAUTH_TOKEN=
